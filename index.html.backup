<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Harsh Akshit - Cybersecurity Professional specializing in AI Safety, LLM Jailbreaking, and Vulnerability Management">
    <meta name="keywords" content="AI Security, LLM Jailbreaking, Application Security, Cybersecurity, Prompt Injection, Cloud Security">
    <meta name="author" content="Harsh Akshit">
    <title>harsh@security:~$</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Font Awesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* Custom CSS Variables */
        :root {
            --deep-space: #0A0E27;
            --charcoal-dark: #1A1D2E;
            --obsidian: #16213E;
            --cyber-cyan: #00F5FF;
            --electric-green: #39FF14;
            --neon-purple: #B026FF;
            --ghost-white: #F8F9FA;
            --silver-gray: #B8C1CC;
            --muted-slate: #6C757D;
            --success-green: #00D9A3;
        }
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'JetBrains Mono', monospace;
            background-color: var(--deep-space);
            color: var(--electric-green);
            line-height: 1.6;
            overflow-x: hidden;
        }
        
        .font-mono {
            font-family: 'JetBrains Mono', monospace;
        }
        
        /* Animated Background */
        .animated-bg {
            background: linear-gradient(135deg, var(--deep-space) 0%, var(--charcoal-dark) 50%, var(--obsidian) 100%);
            position: relative;
        }
        
        .animated-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-image: 
                radial-gradient(circle at 20% 50%, rgba(0, 245, 255, 0.05) 0%, transparent 50%),
                radial-gradient(circle at 80% 80%, rgba(57, 255, 20, 0.05) 0%, transparent 50%);
            animation: pulse 8s ease-in-out infinite;
        }
        
        @keyframes pulse {
            0%, 100% { opacity: 0.5; }
            50% { opacity: 1; }
        }
        
        /* Neon Glow Effect */
        .neon-glow {
            text-shadow: 0 0 10px var(--cyber-cyan),
                         0 0 20px var(--cyber-cyan),
                         0 0 30px var(--cyber-cyan);
        }
        
        .neon-glow-green {
            text-shadow: 0 0 10px var(--electric-green),
                         0 0 20px var(--electric-green);
        }
        
        /* Gradient Text */
        .gradient-text {
            background: linear-gradient(135deg, var(--cyber-cyan) 0%, var(--neon-purple) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        /* CTA Button Styles */
        .btn-primary {
            background: linear-gradient(135deg, var(--cyber-cyan) 0%, #0099CC 100%);
            color: var(--deep-space);
            font-weight: 600;
            padding: 1rem 2rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
        }
        
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 0 30px rgba(0, 245, 255, 0.6);
        }
        
        .btn-secondary {
            border: 2px solid var(--cyber-cyan);
            color: var(--cyber-cyan);
            font-weight: 600;
            padding: 1rem 2rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
            background: transparent;
        }
        
        .btn-secondary:hover {
            background: rgba(0, 245, 255, 0.1);
            transform: translateY(-2px);
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.3);
        }
        
        /* Card Styles */
        .card {
            background: var(--obsidian);
            border: 1px solid rgba(0, 245, 255, 0.2);
            border-radius: 1rem;
            padding: 2rem;
            transition: all 0.3s ease;
        }
        
        .card:hover {
            transform: translateY(-8px);
            border-color: var(--cyber-cyan);
            box-shadow: 0 10px 40px rgba(0, 245, 255, 0.2);
        }
        
        /* Timeline Styles */
        .timeline-dot {
            width: 20px;
            height: 20px;
            background: var(--cyber-cyan);
            border-radius: 50%;
            border: 4px solid var(--deep-space);
            box-shadow: 0 0 0 4px rgba(0, 245, 255, 0.3);
            animation: pulse-dot 2s ease-in-out infinite;
        }
        
        @keyframes pulse-dot {
            0%, 100% { box-shadow: 0 0 0 4px rgba(0, 245, 255, 0.3); }
            50% { box-shadow: 0 0 0 8px rgba(0, 245, 255, 0.1); }
        }
        
        .timeline-line {
            width: 2px;
            background: linear-gradient(to bottom, var(--cyber-cyan), transparent);
        }
        
        /* Skill Pills */
        .skill-pill {
            display: inline-block;
            padding: 0.5rem 1rem;
            background: rgba(0, 245, 255, 0.1);
            border: 1px solid rgba(0, 245, 255, 0.3);
            border-radius: 2rem;
            color: var(--cyber-cyan);
            font-size: 0.875rem;
            margin: 0.25rem;
            transition: all 0.3s ease;
        }
        
        .skill-pill:hover {
            background: rgba(0, 245, 255, 0.2);
            border-color: var(--cyber-cyan);
            box-shadow: 0 0 15px rgba(0, 245, 255, 0.3);
            transform: scale(1.05);
        }
        
        /* Badge Styles */
        .badge {
            background: var(--obsidian);
            border: 2px solid var(--success-green);
            border-radius: 1rem;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
        }
        
        .badge:hover {
            border-color: var(--cyber-cyan);
            box-shadow: 0 0 30px rgba(0, 245, 255, 0.3);
            transform: scale(1.05);
        }
        
        /* Navigation */
        .nav-fixed {
            backdrop-filter: blur(10px);
            background: rgba(10, 14, 39, 0.9);
            border-bottom: 1px solid rgba(0, 245, 255, 0.2);
        }
        
        /* Scroll Indicator */
        .scroll-indicator {
            animation: bounce 2s infinite;
        }
        
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
            40% { transform: translateY(-10px); }
            60% { transform: translateY(-5px); }
        }
        
        /* Social Icons */
        .social-icon {
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            border: 2px solid var(--cyber-cyan);
            color: var(--cyber-cyan);
            transition: all 0.3s ease;
        }
        
        .social-icon:hover {
            background: var(--cyber-cyan);
            color: var(--deep-space);
            transform: rotate(360deg) scale(1.1);
            box-shadow: 0 0 20px rgba(0, 245, 255, 0.5);
        }
        
        /* Section Padding */
        .section-padding {
            padding: 6rem 1rem;
        }
        
        /* Fade In Animation */
        .fade-in {
            animation: fadeIn 1s ease-in;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Code Highlight */
        .code-highlight {
            background: var(--obsidian);
            border-left: 4px solid var(--electric-green);
            padding: 0.25rem 0.75rem;
            border-radius: 0.25rem;
            font-family: 'JetBrains Mono', monospace;
            color: var(--electric-green);
        }
        
        /* Stats Card */
        .stat-card {
            background: linear-gradient(135deg, rgba(0, 245, 255, 0.1) 0%, rgba(176, 38, 255, 0.1) 100%);
            border: 1px solid rgba(0, 245, 255, 0.3);
            border-radius: 1rem;
            padding: 2rem;
            text-align: center;
        }
        
        .stat-number {
            font-size: 3rem;
            font-weight: 700;
            background: linear-gradient(135deg, var(--cyber-cyan) 0%, var(--neon-purple) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
    </style>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'deep-space': '#0A0E27',
                        'charcoal-dark': '#1A1D2E',
                        'obsidian': '#16213E',
                        'cyber-cyan': '#00F5FF',
                        'electric-green': '#39FF14',
                        'neon-purple': '#B026FF',
                        'ghost-white': '#F8F9FA',
                        'silver-gray': '#B8C1CC',
                        'muted-slate': '#6C757D',
                    },
                    fontFamily: {
                        'sans': ['Inter', 'system-ui', 'sans-serif'],
                        'mono': ['JetBrains Mono', 'Fira Code', 'monospace'],
                    }
                }
            }
        }
    </script>
</head>
